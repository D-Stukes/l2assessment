# Groq API Configuration (FREE!)
# Get your free API key from: https://console.groq.com

GROQ_API_KEY=place API key here

# The key is only read by the Express server (server/llm.js), so it is never
# sent to the browser. VITE_GROQ_API_KEY from older setups also still works.
# Without a key, the server falls back to sample categorizations.
#
# Groq offers a generous free tier with fast inference using Llama 3.3 70B model.

# Optional server settings
# PORT=3001
# DB_PATH=server/data/relay.db
